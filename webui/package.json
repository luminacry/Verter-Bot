    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.4",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "shadcn": "^4.21.4",
