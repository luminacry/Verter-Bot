{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol",
  "description": "Root type that exports both message directions in one schema document.",
  "type": "object",
  "properties": {
    "client": {
      "description": "Client-to-runner messages.",
      "$ref": "#/$defs/ClientMessage"
    },
    "server": {
      "description": "Runner-to-client messages.",
      "$ref": "#/$defs/ServerMessage"
    }
  },
  "required": [
    "client",
    "server"
  ],
  "$defs": {
    "BackendKind": {
      "description": "Isolation backend identifiers.",
      "oneOf": [
        {
          "description": "Linux namespaces via the `bwrap` executable.",
          "type": "string",
          "const": "bubblewrap"
        },
        {
          "description": "Linux Landlock, seccomp, and rlimits without namespaces.",
          "type": "string",
          "const": "landlock"
        },
        {
          "description": "Windows lowbox `AppContainer` plus a Job Object.",
          "type": "string",
          "const": "appcontainer"
        },
        {
          "description": "Windows local user created by `setup`, plus a Job Object.",
          "type": "string",
          "const": "isolated"
        },
        {
          "description": "Windows restricted token plus a Job Object. Network denial is not enforced.",
          "type": "string",
          "const": "restricted"
        }
      ]
    },
    "BackendStatus": {
      "description": "Availability of one isolation backend.",
      "type": "object",
      "properties": {
        "available": {
          "description": "Whether the backend can be used on this host.",
          "type": "boolean"
        },
        "detail": {
          "description": "Location of the backend or the reason it is unavailable.",
          "type": "string"
        },
        "kind": {
          "description": "Backend identifier.",
          "$ref": "#/$defs/BackendKind"
        }
      },
      "required": [
        "kind",
        "available",
        "detail"
      ]
    },
    "ClientMessage": {
      "description": "Messages sent by the Verter-Bot core to the runner.",
      "oneOf": [
        {
          "title": "Hello",
          "description": "Handshake. Must be the first message on a connection.",
          "type": "object",
          "properties": {
            "client": {
              "description": "Client identifier, for example `verter/0.1.0`.",
              "type": "string"
            },
            "protocol_version": {
              "description": "Protocol version the client speaks.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "hello"
            }
          },
          "required": [
            "type",
            "client",
            "protocol_version"
          ]
        },
        {
          "title": "Ping",
          "description": "Liveness check, answered with [`ServerMessage::Pong`].",
          "type": "object",
          "properties": {
            "nonce": {
              "description": "Opaque value echoed back in the reply.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "ping"
            }
          },
          "required": [
            "type",
            "nonce"
          ]
        },
        {
          "title": "Exec",
          "description": "Run a command inside an isolation backend. Refusals use the error channel.",
          "type": "object",
          "properties": {
            "backend": {
              "description": "Isolation backend. `auto` never falls through to the host.",
              "$ref": "#/$defs/ExecBackend"
            },
            "command": {
              "description": "Program and arguments. The first item is the executable.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "id": {
              "description": "Correlation id echoed in stdout, stderr, and exit messages.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "memory_bytes": {
              "description": "Address-space / job memory limit in bytes.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "network": {
              "description": "When true, outbound network is requested.",
              "type": "boolean"
            },
            "nproc": {
              "description": "Process-count limit inside the sandbox.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "timeout_ms": {
              "description": "Wall-clock limit in milliseconds.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "exec"
            },
            "workspace": {
              "description": "Writable workspace directory on the host.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "command",
            "workspace",
            "backend",
            "network",
            "timeout_ms",
            "memory_bytes",
            "nproc"
          ]
        },
        {
          "title": "Shutdown",
          "description": "Ask the runner to exit.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "shutdown"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ErrorCode": {
      "description": "Reasons a message can be rejected.",
      "oneOf": [
        {
          "description": "The line was not a valid client message.",
          "type": "string",
          "const": "invalid_message"
        },
        {
          "description": "A message other than `hello` or `shutdown` arrived before the handshake.",
          "type": "string",
          "const": "handshake_required"
        },
        {
          "description": "The client's protocol version is not supported.",
          "type": "string",
          "const": "unsupported_protocol_version"
        },
        {
          "description": "No isolation backend can run the command; it was not started on the host.",
          "type": "string",
          "const": "isolation_unavailable"
        },
        {
          "description": "The workspace path is missing, is not a directory, or cannot be used.",
          "type": "string",
          "const": "invalid_workspace"
        },
        {
          "description": "The `exec` request was malformed or cannot be honored on this platform.",
          "type": "string",
          "const": "invalid_exec"
        }
      ]
    },
    "ExecBackend": {
      "description": "Backend requested by [`ClientMessage::Exec`].",
      "oneOf": [
        {
          "description": "Host default. Never falls through to an unsandboxed run.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Linux namespaces via the `bwrap` executable.",
          "type": "string",
          "const": "bubblewrap"
        },
        {
          "description": "Linux Landlock, seccomp, and rlimits without namespaces.",
          "type": "string",
          "const": "landlock"
        },
        {
          "description": "Windows lowbox `AppContainer` plus a Job Object.",
          "type": "string",
          "const": "appcontainer"
        },
        {
          "description": "Windows local user created by `setup`, plus a Job Object.",
          "type": "string",
          "const": "isolated"
        },
        {
          "description": "Windows restricted token plus a Job Object.",
          "type": "string",
          "const": "restricted"
        }
      ]
    },
    "PlatformInfo": {
      "description": "Host platform reported during the handshake.",
      "type": "object",
      "properties": {
        "arch": {
          "description": "CPU architecture, as in Rust's `std::env::consts::ARCH`.",
          "type": "string"
        },
        "backends": {
          "description": "Isolation backends known on this platform.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BackendStatus"
          }
        },
        "os": {
          "description": "Operating system, as in Rust's `std::env::consts::OS`.",
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch",
        "backends"
      ]
    },
    "ServerMessage": {
      "description": "Messages sent by the runner to the Verter-Bot core.",
      "oneOf": [
        {
          "title": "HelloAck",
          "description": "Successful handshake.",
          "type": "object",
          "properties": {
            "platform": {
              "description": "Host platform and isolation backends detected by the runner.",
              "$ref": "#/$defs/PlatformInfo"
            },
            "protocol_version": {
              "description": "Protocol version the runner speaks.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "server_version": {
              "description": "Runner version.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "hello_ack"
            }
          },
          "required": [
            "type",
            "server_version",
            "protocol_version",
            "platform"
          ]
        },
        {
          "title": "Pong",
          "description": "Reply to [`ClientMessage::Ping`].",
          "type": "object",
          "properties": {
            "nonce": {
              "description": "The nonce from the matching ping.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "pong"
            }
          },
          "required": [
            "type",
            "nonce"
          ]
        },
        {
          "title": "ExecStdout",
          "description": "One chunk of the command's standard output, base64-encoded.",
          "type": "object",
          "properties": {
            "chunk_b64": {
              "description": "Standard-output bytes, standard base64 with padding.",
              "type": "string"
            },
            "id": {
              "description": "The `id` from the matching [`ClientMessage::Exec`].",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "exec_stdout"
            }
          },
          "required": [
            "type",
            "id",
            "chunk_b64"
          ]
        },
        {
          "title": "ExecStderr",
          "description": "One chunk of the command's standard error, base64-encoded.",
          "type": "object",
          "properties": {
            "chunk_b64": {
              "description": "Standard-error bytes, standard base64 with padding.",
              "type": "string"
            },
            "id": {
              "description": "The `id` from the matching [`ClientMessage::Exec`].",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "exec_stderr"
            }
          },
          "required": [
            "type",
            "id",
            "chunk_b64"
          ]
        },
        {
          "title": "ExecExit",
          "description": "The sandboxed command has exited. Always the last message for an `exec`.",
          "type": "object",
          "properties": {
            "backend": {
              "description": "Backend that actually isolated the command.",
              "$ref": "#/$defs/BackendKind"
            },
            "exit_code": {
              "description": "Process exit code. `124` when the wall-clock limit fired.",
              "type": "integer",
              "format": "int32"
            },
            "id": {
              "description": "The `id` from the matching [`ClientMessage::Exec`].",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "timed_out": {
              "description": "True when the wall-clock limit fired and the process tree was killed.",
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "exec_exit"
            },
            "wall_ms": {
              "description": "Wall-clock milliseconds from spawn until exit.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "id",
            "exit_code",
            "timed_out",
            "backend",
            "wall_ms"
          ]
        },
        {
          "title": "ErrorReply",
          "description": "The previous message was rejected.",
          "type": "object",
          "properties": {
            "code": {
              "description": "Machine-readable error kind.",
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "description": "Human-readable description.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ]
        }
      ]
    }
  }
}
